PASSBOLT_FQDN=passbolt.intra.local
PASSBOLT_HTTP_PORT=80
PASSBOLT_HTTPS_PORT=443
TIMEZONE=Europe/Paris

PASSBOLT_IMAGE=passbolt/passbolt:latest-ce-non-root
MARIADB_IMAGE=mariadb:10.11

DB_NAME=passbolt
DB_USER=passbolt
DB_PASSWORD=CHANGE_ME_BEFORE_INSTALL
DB_ROOT_RANDOM=true

PASSBOLT_KEY_NAME=Passbolt Server
PASSBOLT_KEY_EMAIL=passbolt@intra.local
PASSBOLT_KEY_LENGTH=3072
PASSBOLT_KEY_EXPIRATION=0

FIRST_ADMIN_EMAIL=admin@example.internal
FIRST_ADMIN_FIRSTNAME=Admin
FIRST_ADMIN_LASTNAME=Example

SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=
EMAIL_DEFAULT_FROM_NAME=Passbolt
EMAIL_DEFAULT_FROM=passbolt@intra.local
